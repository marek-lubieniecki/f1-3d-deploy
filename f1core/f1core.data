  "assumptions": {
    "_note": "Power-limited-pending period model. Start/end/re-arm are defined in FIA-F1-DOC-058 (not available); adopted from press reporting (source below) as the project's working rule. Keep configurable.",
    "period_start_pedal_threshold": {
      "value": 0.98,
      "unit": "-",
      "ref": "press: The Race, 2026-03-24, 'Charles Leclerc lap F1 2026 qualifying ruined, cars confused' (Chinese GP SQ3, T10 exit): https://www.the-race.com/formula-1/charles-leclerc-lap-f1-2026-qualifying-ruined-cars-confused/ -- 'throttle registered at 98% or greater'; owner input; racing_optimizer _stage_helpers.py uses >= 0.98",
      "status": "adopted (press source, DOC-058 unverified)"
    },
    "reference_power_for_reduction": {
      "value": "P_ICE_available + 350 kW",
      "unit": "-",
      "ref": "assumption; C5.12 does not define the reference",
      "status": "assumption"
    },
    "min_deploy_during_hold": {
      "value": 200,
      "unit": "kW",
      "ref": "press: The Race, 2026-03-24, 'Charles Leclerc lap F1 2026 qualifying ruined, cars confused' (Chinese GP SQ3, T10 exit): https://www.the-race.com/formula-1/charles-leclerc-lap-f1-2026-qualifying-ruined-cars-confused/ -- deployment 'cut to a minimum of 200kW'; consistent with 350 - 150 (C5.12.4)",
      "status": "adopted (press source, DOC-058 unverified)"
    },
    "rearm_on_lift": {
      "value": true,
      "unit": "-",
      "ref": "press: The Race, 2026-03-24, 'Charles Leclerc lap F1 2026 qualifying ruined, cars confused' (Chinese GP SQ3, T10 exit): https://www.the-race.com/formula-1/charles-leclerc-lap-f1-2026-qualifying-ruined-cars-confused/ -- lift to 95% reset the sequence; owner input",
      "status": "adopted (press source, DOC-058 unverified)",
      "note": "Article predates Section C Iss 17 (2026-04-28) and later in-season changes; re-check if newer evidence appears. Open detail: article says '98% or greater for at least one second' -- whether 1 s at >=98% is needed before the period counts is ambiguous; config key period_start_min_time_s."
    },
    "rearm_hysteresis": {
      "value": null,
      "unit": "-",
      "ref": "no source",
      "status": "gap"
    },
    "min_lift_time": {
      "value": null,
      "unit": "s",
      "ref": "no source",
      "status": "gap"
    },
    "period_start_min_time_s": {
      "value": 0.0,
      "unit": "s",
      "ref": "press: The Race, 2026-03-24, 'Charles Leclerc lap F1 2026 qualifying ruined, cars confused' (Chinese GP SQ3, T10 exit): https://www.the-race.com/formula-1/charles-leclerc-lap-f1-2026-qualifying-ruined-cars-confused/ -- ambiguous wording '98% or greater for at least one second'; 0 = period starts on the crossing, hold of 1 s per C5.12.4",
      "status": "assumption"
    }
  },
